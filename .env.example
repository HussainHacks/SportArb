# === Sports Arbitrage Odds Scanner — Environment Variables ===

# The Odds API (get free key at https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://sportsarb:sportsarb_dev@localhost:5432/sportsarb

# Scanner Settings
POLL_INTERVAL_SECONDS=30
DEFAULT_STAKE=1000
MIN_ARB_PERCENT=0.5
MAX_ARB_PERCENT=20.0
STALE_ODDS_SECONDS=60
